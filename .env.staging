# ============================================================
# UNISOLE ENGINE — STAGING ENVIRONMENT
# ============================================================
NODE_ENV=staging
PORT=3001

# Isolated Staging PostgreSQL Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5434/unisole_staging

# Security & JWT Tokens
JWT_SECRET=unisole-staging-secret-key-2026
JWT_REFRESH_SECRET=unisole-staging-refresh-secret-key-2026

# Razorpay Test Gateway (Sandbox)
RAZORPAY_KEY_ID=rzp_test_staging_dummy
RAZORPAY_KEY_SECRET=rzp_test_secret_staging_dummy
RAZORPAY_WEBHOOK_SECRET=unisole_webhook_staging_2026

# CORS Allowed Origins
CORS_ORIGINS=https://stg.admin.unisole.org,https://stg.lms.unisole.org,https://stg.unisole.org,https://stg-admin.unisole.org,https://stg-lms.unisole.org,https://stg-seo.unisole.org,http://localhost:5183,http://localhost:5184,http://localhost:5185,http://localhost:5173,http://localhost:5174,http://localhost:5175
