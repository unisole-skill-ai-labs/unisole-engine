{
  "name": "unisole-engine",
  "version": "2.0.1",
  "description": "Backend engine for the Unisole EdTech platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:migrate:dev": "tsx src/scripts/migrate.ts",
    "db:seed": "node dist/scripts/seed-system.js",
    "db:seed:system": "node dist/scripts/seed-system.js",
    "db:seed:partners": "node dist/scripts/seed-partner-colleges.js",
    "db:seed:demo": "node dist/scripts/seed-demo-analytics.js",
    "db:seed:survey": "tsx src/scripts/seed-survey.ts",
    "db:seed:dev": "tsx src/scripts/seed-system.ts",
    "seed:ai-agent": "node dist/scripts/seed-ai-agent-curriculum.js",
    "seed:ai-agent:dev": "tsx src/scripts/seed-ai-agent-curriculum.ts",
    "seed:genai": "node dist/scripts/seed-genai-curriculum.js",
    "seed:genai:dev": "tsx src/scripts/seed-genai-curriculum.ts",
    "db:seed:agent": "node dist/scripts/seed-ai-agent-curriculum.js",
    "db:seed:agent:dev": "tsx src/scripts/seed-ai-agent-curriculum.ts",
    "db:seed:calendar": "node dist/scripts/seed-ai-agent-calendar.js",
    "db:seed:calendar:dev": "tsx src/scripts/seed-ai-agent-calendar.ts",
    "db:sync:pathways": "node dist/scripts/sync-canonical-pathways.js",
    "db:sync:pathways:dev": "tsx src/scripts/sync-canonical-pathways.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.1.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
