# ===== Production Environment Variables =====
# IMPORTANT: Set these securely in GitHub Secrets and on EC2

# Node Environment
NODE_ENV=production

# API Configuration
API_PORT=3000
API_BASE_URL=https://yourdomain.com

# Database Configuration
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=unisole

# JWT Secrets (Generate strong random values)
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_VALUE_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_VALUE

# Payment Gateway (Razorpay Production Keys)
RAZORPAY_KEY_ID=your_razorpay_production_key_id
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_PRODUCTION_KEY
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Fast2SMS OTP & WhatsApp Gateway Configuration
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_WHATSAPP_MESSAGE_ID=32030
FAST2SMS_SENDER_ID=UNISLE
OTP_PROVIDER=FAST2SMS

# Docker Registry
DOCKER_USERNAME=your_docker_username

# Email/Notifications (Optional)
SMTP_HOST=your-email-provider
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASSWORD=your-email-password
