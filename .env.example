PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unisole
ADMIN_EMAIL=admin@unisole.test
ADMIN_PASSWORD=Admin@Pop#2000
DEFAULT_OTP=1234

# Lesson Video & Azure Blob Storage
# Storage backend: "stub" for local/dev or "azure" for Azure Blob Storage
VIDEO_STORAGE_MODE=
# Upload mode: "hls" (default), "simple" (MP4), or "both"
VIDEO_UPLOAD_MODE=
# Maximum upload size in MB (default 500)
VIDEO_MAX_SIZE_MB=
# Playback SAS URL lifetime in seconds (default 21600 = 6 hours)
VIDEO_PLAY_TTL_SECONDS=
# Azure Storage account name
AZURE_STORAGE_ACCOUNT=
# Azure Storage access key, never commit a real value
AZURE_STORAGE_ACCOUNT_KEY=
# Private Azure Blob container name for lesson videos (default hls)
AZURE_HLS_CONTAINER=
# Optional custom Azure Blob endpoint (e.g. Azurite); leave empty for default Azure endpoint
AZURE_STORAGE_ENDPOINT=

# Google Drive OAuth2 Storage (personal Gmail, drive.file scope)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GDRIVE_ROOT_FOLDER_ID=



